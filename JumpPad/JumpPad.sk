# =============================================================
# JumpPad.sk
# 
# [概要] 感圧版の下のブロックに応じた特殊移動ギミック
# [対応] Minecraft 1.21.11
# [作成] ryoma_1125 (https://x.com/ryoma_1125)
# [GitHub] https://github.com/ryoma-1125
# [ライセンス] MIT License
# =============================================================

# --- 設定項目  ---
options:
    # チェック間隔
    CheckInterval: 1 second

    # ダイヤモンド (視線移動)
    DiamondSpeed: 7.0

    # エメラルド (空中滑空)
    EmeraldUp: 2.0
    EmeraldForward: 1.0
    EmeraldLevitationTime: 6 seconds
    EmeraldSlowFallingTime: 10 seconds

    # 金 (垂直上昇 大)
    GoldUp: 2.5

    # 石炭 (垂直上昇 小)
    CoalUp: 1.5

    # 鉄 (水平加速)
    IronUp: 0.8
    IronForward: 3.0

# --- メイン処理 ---
on step on pressure plate:
    set {_u} to uuid of player
    set {_b} to block 1 below event-block
    
    # --- 隣接チェック ---
    # 東西南北に「対応ブロック」が1つでもあれば無効化
    set {_adj} to 0
    loop block north of {_b}, block south of {_b}, block east of {_b} and block west of {_b}:
        set {_t} to "%type of loop-value%"
        if {_t} contains "gold block" or "iron block" or "coal block" or "diamond block" or "emerald block":
            add 1 to {_adj}
    
    if {_adj} > 0:
        send message "&c&lエラー: &fパッドが隣接しているため無効です" to player
        stop

    # --- 正常な処理開始 ---
    set fall distance of player to 0
    
    # ダイヤモンド：視線移動
    if block 1 below event-block is diamond block:
        play sound "entity.illusioner.mirror_move" with volume 1 and pitch 1.5 at event-location
        push player in direction of player at speed {@DiamondSpeed}
        set {fall_protection::%{_u}%} to true
        send action bar "&b&l視線移動！！" to player

    # エメラルド：空中滑空
    else if block 1 below event-block is emerald block:
        play sound "entity.shulker.shoot" with volume 1 and pitch 1 at event-location
        push player upwards at speed {@EmeraldUp}
        wait 1 tick
        push player forward at speed {@EmeraldForward}
        apply levitation 1 to player for {@EmeraldLevitationTime}
        apply slow falling 1 to player for {@EmeraldSlowFallingTime}
        set {fall_protection::%{_u}%} to true
        send action bar "&a&l空中滑空！！" to player

    # 金ブロック：垂直上昇 大
    else if block 1 below event-block is gold block:
        play sound "entity.firework_rocket.launch" with volume 1 and pitch 1 at event-location
        push player upwards at speed {@GoldUp}
        set {fall_protection::%{_u}%} to true
        send action bar "&e&l上昇中！！" to player
        
    # 石炭ブロック：垂直上昇 小
    else if block 1 below event-block is coal block:
        play sound "entity.firework_rocket.launch" with volume 1 and pitch 1 at event-location
        push player upwards at speed {@CoalUp}
        set {fall_protection::%{_u}%} to true
        send action bar "&2&l上昇中..." to player

    # 鉄ブロック：水平加速
    else if block 1 below event-block is iron block:
        play sound "entity.firework_rocket.blast" with volume 1 and pitch 1.5 at event-location
        
        # 1. 垂直に浮かせる
        push player upwards at speed {@IronUp}
        
        # 2. 水平方向の前方へ飛ばす
        push player horizontal forward at speed {@IronForward}
        
        set {fall_protection::%{_u}%} to true
        send action bar "&b&l水平加速！！" to player

# --- 落下ダメージ保護 ---
on damage:
    if damage cause is fall:
        if {fall_protection::%uuid of victim%} is true:
            cancel event
            play sound "entity.generic.small_fall" with volume 0.5 and pitch 2 to victim

# プレート以外の地面に着いたら保護を終了
every {@CheckInterval}:
    loop all players:
        set {_u} to uuid of loop-player
        if {fall_protection::%{_u}%} is true:
            if loop-player is on ground:
                set {_b} to "%block at loop-player%"
                if {_b} does not contain "plate":
                    delete {fall_protection::%{_u}%}

on quit:
    delete {fall_protection::%uuid of player%}
